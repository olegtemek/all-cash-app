# Этот файл лежит рядом с docker-compose.yml в корне репозитория. Скопируйте его в .env:
# оттуда настройки читают и `make run` (из backend/), и docker compose (env_file).

# Путь к файлу SQLite. Относительный путь считается от рабочего каталога: на хосте это
# корень проекта, в контейнере — /app, куда смонтирован каталог ALL_CASH_DATA_DIR.
ALL_CASH_APP_DB_PATH=./data/all_cash.db

# Каталог на хосте, который docker compose монтирует внутрь контейнера как ./data.
ALL_CASH_DATA_DIR=./data

# Пользователь процесса в контейнере. По умолчанию uid образа (10001). На Linux укажите
# свои id, иначе контейнер не сможет писать в ALL_CASH_DATA_DIR: ALL_CASH_DOCKER_USER=$(id -u):$(id -g).
ALL_CASH_DOCKER_USER=10001:10001

# Записей в одном ответе GET /pull. Потолок — 5000.
ALL_CASH_APP_PULL_LIMIT=2000

# Уровень логирования: debug, info, warn, error.
ALL_CASH_APP_LOG_LEVEL=info

# Порт HTTP. Сервер слушает его и внутри контейнера, и на хосте.
ALL_CASH_SERVER_PORT=8000

# Таймауты HTTP и ожидание graceful shutdown.
ALL_CASH_SERVER_READ_TIMEOUT=30s
ALL_CASH_SERVER_WRITE_TIMEOUT=30s
ALL_CASH_SERVER_SHUTDOWN_TIMEOUT=10s

# Источники страниц в браузере, которым разрешено обращаться к API: список через запятую,
# например http://192.168.1.10:5173. По умолчанию * — любой источник. Доступ к данным это
# не даёт: он по-прежнему только по X-Login. Нативному клиенту настройка не нужна.
ALL_CASH_SERVER_CORS_ORIGINS=*

# Адрес, на котором docker compose публикует порт. По умолчанию 127.0.0.1 — сервер
# доступен только с самой машины. Для доступа с устройств локальной сети укажите
# адрес машины, например 192.168.1.10. Наружу порт не открывать.
ALL_CASH_BIND_ADDRESS=127.0.0.1

# Порт веб-клиента на хосте (nginx внутри контейнера слушает 80).
ALL_CASH_WEB_PORT=8081

# Образы из реестра (Docker Hub). Формат user/name. Тег общий для обоих образов.
# Для сборки и публикации: docker compose -f docker-compose.yml -f docker-compose.build.yml build|push
# Сборка под сервер amd64 на Mac M-чипе: DOCKER_DEFAULT_PLATFORM=linux/amd64
ALL_CASH_SERVER_IMAGE=username/all-cash-server
ALL_CASH_WEB_IMAGE=username/all-cash-web
ALL_CASH_IMAGE_TAG=latest
